# Puerto HTTP de la API. Se usa API_PORT (no PORT) para no chocar con el puerto del frontend
# cuando ambos servidores se ejecutan desde el mismo entorno con `npm run dev`.
API_PORT=3001

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# true => SnailPay responde 503 a todas las solicitudes (simulación de caída del servicio)
SNAILPAY_SIMULATE_OUTAGE=false

# Retardo (ms) aplicado por la tarjeta de prueba de timeout antes de responder
SNAILPAY_TIMEOUT_DELAY_MS=15000
